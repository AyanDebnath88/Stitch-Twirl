# Copy this file to .env and fill in real values once each account is approved.
# .env is git-ignored — never commit real keys.

# Razorpay (Settings > API Keys in the Razorpay dashboard, after KYC is approved)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shiprocket (your login email/password for shiprocket.in — their API uses
# account credentials to issue a short-lived auth token, there's no separate API key)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location nickname exactly as set up in Shiprocket > Settings > Pickup Addresses
SHIPROCKET_PICKUP_LOCATION=

# Google Sheet order tracker — the Web App URL you get after deploying
# apps-script/OrderTracker.gs from within the Sheet (Extensions > Apps Script > Deploy)
SHEET_WEBHOOK_URL=

---
interface Props {
  size?: number;
  class?: string;
}
const { size = 34, class: className = "" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 96 96"
  class={className}
  aria-hidden="true"
>
  <circle cx="48" cy="48" r="44" fill="none" stroke="currentColor" stroke-width="2"></circle>
  <circle cx="40" cy="48" r="13" fill="none" stroke="currentColor" stroke-width="4"></circle>
  <circle cx="56" cy="48" r="13" fill="none" stroke="currentColor" stroke-width="4"></circle>
</svg>

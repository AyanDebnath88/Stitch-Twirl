---
// A hairline paisley/boteh trim — one quiet nod to Indian textile-border
// tradition, used in place of a plain rule. Monoline, currentColor, tiny.
interface Props {
  class?: string;
  color?: string;
}
const { class: className = "", color = "var(--ink-45)" } = Astro.props;
---

<svg
  class:list={["w-full h-3.5", className]}
  viewBox="0 0 48 14"
  preserveAspectRatio="xMidYMid slice"
  style={{ color }}
  aria-hidden="true"
>
  <defs>
    <pattern id="paisley-trim" width="16" height="14" patternUnits="userSpaceOnUse">
      <path
        d="M8 3c-2.2 0-3.6 1.6-3.6 3.6 0 1.7 1.1 2.8 2.6 2.8.6 0 .9-.4.6-.9-.3-.4-.9-.2-1.1-.6-.5-.7 0-1.7.9-1.7 1.4 0 2.3 1.1 2.3 2.5 0 1.7-1.4 3.1-3.4 3.1"
        fill="none"
        stroke="currentColor"
        stroke-width="0.9"
        stroke-linecap="round"
      ></path>
    </pattern>
  </defs>
  <rect width="48" height="14" fill="url(#paisley-trim)"></rect>
</svg>

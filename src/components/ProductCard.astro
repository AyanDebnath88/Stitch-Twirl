---
import type { CollectionEntry } from "astro:content";

interface Props {
  product: CollectionEntry<"products">;
  index: number;
}

const { product, index } = Astro.props;
const { title, sku, price, heroImage, tier, status, leadTime } = product.data;
const lotNumber = String(index).padStart(3, "0");
---

<a
  href={`/shop/${product.id}`}
  class="group block"
>
  <div class="aspect-[4/5] overflow-hidden rounded-3xl bg-cream-dark relative">
    <img
      src={heroImage}
      alt={title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
      loading="lazy"
    />
    {status === "sold" && (
      <span class="absolute inset-0 bg-ink/50 flex items-center justify-center text-white font-display text-lg">
        Sold
      </span>
    )}
  </div>
  <div class="pt-3">
    <p class="font-mono text-[11px] tracking-[0.08em] text-terracotta-dark">
      N&deg;{lotNumber} &mdash; {tier === "signature" ? "Signature" : "Quick-Ship"}
    </p>
    <h3 class="font-display text-lg text-ink mt-0.5">{title}</h3>
    <p class="text-ink-soft text-sm mt-1">{leadTime}</p>
    <p class="text-ink font-medium mt-1.5">₹{price.toLocaleString("en-IN")}</p>
  </div>
</a>

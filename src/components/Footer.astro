---
import Logomark from "./Logomark.astro";
import { SITE, CONTACT, whatsappLink } from "../consts";

const currentYear = new Date().getFullYear();
---

<footer class="bg-ink text-oat">
  <div
    class="max-w-[1280px] mx-auto px-5 sm:px-20 pt-16 sm:pt-24 pb-10 grid gap-10 sm:gap-12 sm:[grid-template-columns:1.4fr_1fr_1fr_1fr]"
  >
    <div>
      <div class="flex items-center gap-3">
        <Logomark size={30} class="text-oat" />
        <span class="wordmark text-xl">{SITE.name}</span>
      </div>
      <p class="mt-3 text-sm text-oat/70 max-w-xs">{SITE.tagline}</p>
      <a
        href={whatsappLink("Hi! I'd like 10% off my first order 🧶")}
        class="inline-block mt-4 text-xs uppercase tracking-[0.08em] text-clay-soft"
      >
        Get 10% off — message us on WhatsApp
      </a>
    </div>

    <div>
      <p class="eyebrow text-oat/50 mb-4">Shop</p>
      <div class="flex flex-col gap-2 text-sm text-oat/80">
        <a href="/shop#signature" class="hover:text-clay-soft">Signature</a>
        <a href="/shop#quick-ship" class="hover:text-clay-soft">Quick-Ship</a>
        <a href="/faq#care" class="hover:text-clay-soft">Care Guide</a>
      </div>
    </div>

    <div>
      <p class="eyebrow text-oat/50 mb-4">Support</p>
      <div class="flex flex-col gap-2 text-sm text-oat/80">
        <a href="/faq#returns" class="hover:text-clay-soft">Shipping &amp; Returns</a>
        <a href="/faq#grievance" class="hover:text-clay-soft">Contact</a>
        <a href="/faq" class="hover:text-clay-soft">FAQs</a>
      </div>
    </div>

    <div>
      <p class="eyebrow text-oat/50 mb-4">Follow</p>
      <a
        href={`https://instagram.com/${CONTACT.instagramHandle}`}
        class="text-sm text-oat/80 hover:text-clay-soft"
      >
        {CONTACT.instagramHandle}
      </a>
    </div>
  </div>

  <div
    class="border-t border-oat/15 px-5 sm:px-20 py-5 flex flex-col sm:flex-row gap-1 sm:gap-4 text-[12px] text-oat/50"
  >
    <span>&copy; {currentYear} {SITE.name}. Handmade in India.</span>
    <span>Every piece is one of one.</span>
  </div>
</footer>

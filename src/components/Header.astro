---
import { SITE } from "../consts";
---

<header class="border-b border-line bg-cream/95 backdrop-blur sticky top-0 z-50">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-4 flex items-center justify-between">
    <a href="/" class="font-display text-xl sm:text-2xl tracking-tight text-ink">
      {SITE.name}
    </a>
    <nav class="flex items-center gap-4 sm:gap-6 text-sm sm:text-base text-ink-soft">
      <a href="/shop" class="hover:text-terracotta transition-colors">Shop</a>
      <a href="/about" class="hover:text-terracotta transition-colors">Our Story</a>
      <a href="/faq" class="hover:text-terracotta transition-colors">FAQ</a>
    </nav>
  </div>
</header>

---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getCollection } from "astro:content";

const allProducts = (await getCollection("products")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const signature = allProducts.filter((p) => p.data.tier === "signature");
const quickShip = allProducts.filter((p) => p.data.tier === "quick-ship");
---

<Layout title="Shop">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-12 sm:py-16">
    <h1 class="font-display text-3xl sm:text-4xl text-ink mb-2">Shop</h1>
    <p class="text-ink-soft mb-10">
      Everything here is made by hand, in small batches. What you see is what's
      actually finished and ready — no backorders, no fake countdowns.
    </p>

    <section class="mb-14">
      <h2 class="font-display text-2xl text-ink mb-1">Signature pieces</h2>
      <p class="text-ink-soft text-sm mb-6">
        Larger, made-to-take-time pieces — blankets, cardigans, bags.
      </p>
      {signature.length > 0 ? (
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 sm:gap-6">
          {signature.map((product) => <ProductCard product={product} />)}
        </div>
      ) : (
        <p class="text-ink-soft text-sm">No signature pieces live right now — check back soon.</p>
      )}
    </section>

    <section>
      <h2 class="font-display text-2xl text-ink mb-1">Quick-ship</h2>
      <p class="text-ink-soft text-sm mb-6">
        Smaller pieces made between the big ones — coasters, keychains, baby items, amigurumi.
      </p>
      {quickShip.length > 0 ? (
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 sm:gap-6">
          {quickShip.map((product) => <ProductCard product={product} />)}
        </div>
      ) : (
        <p class="text-ink-soft text-sm">No quick-ship pieces live right now — check back soon.</p>
      )}
    </section>
  </div>
</Layout>

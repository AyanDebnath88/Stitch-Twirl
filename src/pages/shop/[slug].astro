---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { whatsappLink } from "../../consts";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { title, sku, price, tier, status, leadTime, materials, images, heroImage, sizeGuide, careInstructions, paymentLinkUrl, whatsappMessage } =
  product.data;
const { Content } = await render(product);

const gallery = images.length > 0 ? images : [heroImage];
const waLink = whatsappLink(whatsappMessage ?? `Hi! I'd like to order "${title}" (₹${price}).`);
---

<Layout title={product.data.seoTitle ?? title} description={product.data.seoDescription} activePage="shop">
  <div class="max-w-[1280px] mx-auto px-5 sm:px-20 py-12 sm:py-20 grid sm:grid-cols-2 gap-8 sm:gap-16">
    <div class="grid grid-cols-1 gap-3">
      {gallery.map((src) => (
        <img src={src} alt={title} class="w-full aspect-[4/5] object-cover rounded-[2px]" />
      ))}
    </div>

    <div>
      <p class="eyebrow text-clay mb-4">
        {sku} &mdash; {tier === "signature" ? "Signature" : "Quick-Ship"} &middot; one of one
      </p>
      <h1 class="h-serif text-3xl sm:text-4xl text-ink mb-3">{title}</h1>
      <p class="text-2xl text-ink mb-1">₹{price.toLocaleString("en-IN")}</p>
      {leadTime && <p class="text-ink-70 text-sm mb-8">{leadTime}</p>}

      {status === "available" ? (
        <div class="flex flex-col sm:flex-row gap-3 mb-10">
          {paymentLinkUrl ? (
            <a href={paymentLinkUrl} class="btn flex-1 justify-center text-ink hover:bg-ink hover:text-oat transition-colors">
              Buy Now
            </a>
          ) : (
            <span class="btn flex-1 justify-center text-ink-45 border-line">
              Payment link coming soon
            </span>
          )}
          <a href={waLink} class="btn flex-1 justify-center text-clay hover:bg-clay hover:text-oat transition-colors">
            Order on WhatsApp
          </a>
        </div>
      ) : (
        <p class="btn inline-flex mb-10 text-ink-45 border-line">This piece has been sold</p>
      )}

      <div class="text-ink-70 text-sm mb-8 [&>p]:mb-3">
        <Content />
      </div>

      {materials && (
        <p class="text-sm text-ink-70 mb-2"><span class="text-ink">Materials:</span> {materials}</p>
      )}
      {sizeGuide && (
        <p class="text-sm text-ink-70 mb-2"><span class="text-ink">Size guide:</span> {sizeGuide}</p>
      )}
      <p class="text-sm text-ink-70"><span class="text-ink">Care:</span> {careInstructions}</p>
    </div>
  </div>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import MakerStory from "../components/MakerStory.astro";
import ProductGrid from "../components/ProductGrid.astro";
import CraftStrip from "../components/CraftStrip.astro";
import { getCollection } from "astro:content";

const allProducts = (await getCollection("products")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const available = allProducts.filter((p) => p.data.status === "available").slice(0, 6);
---

<Layout activePage="home">
  <Hero />
  <MakerStory />
  <ProductGrid
    eyebrow="Currently Available"
    heading="This Season's Small Batch"
    subcopy="What's actually finished and ready to ship — no backorders."
    products={available}
    emptyText="Nothing's live yet — the first pieces are on their way. Check back soon."
    ghost
  />
  <CraftStrip />
</Layout>
